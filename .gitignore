# File: .gitignore
# This tells Git what NOT to commit

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data & Models
data/raw/
data/processed/
models/*.pkl
models/*.joblib
outputs/models/*.pkl

# Large files
*.csv  # Comment this out if you want to commit sample data
*.zip
*.tar.gz

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary
temp/
tmp/
*.temp
